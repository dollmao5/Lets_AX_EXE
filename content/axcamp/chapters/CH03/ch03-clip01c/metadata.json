fileSafe(v){return safe(v||&#x27;작성자&#x27;).replace(/[^0-9A-Za-z가-힣._-]+/g,&#x27;_&#x27;)||&#x27;작성자&#x27;;}\n  function buildMarkdown(){\n    var pasteEl=root.querySelector(&#x27;[data-rev-field=pasteAll]&#x27;);\n    if(pasteEl&amp;&amp;safe(pasteEl.value)){return safe(pasteEl.value);}\n    var titleEl=root.querySelector(&#x27;.clip-title&#x27;);\n    var title=root.getAttribute(&#x27;data-md-title&#x27;)||(titleEl?titleEl.textContent:root.id);\n    var lines=[&#x27;# &#x27;+safe(title),&#x27;&#x27;,&#x27;- 저장 시각: &#x27;+new Date().toLocaleString(&#x27;ko-KR&#x27;),&#x27;&#x27;];\n    var last=&#x27;&#x27;;\n    fields.forEach(function(f){\n      if(f.getAttribute(&#x27;data-rev-field&#x27;)===&#x27;pasteAll&#x27;){return;}\n      var section=f.getAttribute(&#x27;data-md-section&#x27;)||&#x27;작성 내용&#x27;;\n      var label=f.getAttribute(&#x27;data-md-label&#x27;)||f.getAttribute(&#x27;data-rev-field&#x27;);\n      if(section!==last){lines.push(&#x27;## &#x27;+section);last=section;}\n      lines.push(&#x27;- &#x27;+label+&#x27;: &#x27;+(safe(f.value)||&#x27;미입력&#x27;));\n    });\n    return lines.join(&#x27;\\n&#x27;);\n  }\n  function download(){\n    save(true);\n    var nameRoot=root.getAttribute(&#x27;data-download-name&#x27;)||root.id;\n    var who=root.querySelector(&#x27;[data-rev-field=teamName],[data-rev-field=name]&#x27;);\n    var prefix=who&amp;&amp;safe(who.value)?fileSafe(who.value)+&#x27;_&#x27;:&#x27;&#x27;;\n    var a=document.createElement(&#x27;a&#x27;);\n    var objectUrl=&#x27;&#x27;;\n    a.download=(prefix?nameRoot.replace(/_(팀번호|성명)$/,&#x27;&#x27;)+&#x27;_&#x27;+prefix.slice(0,-1):nameRoot)+&#x27;.md&#x27;;\n    if(window.URL&amp;&amp;typeof URL.createObjectURL===&#x27;function&#x27;){\n      var blob=new Blob([buildMarkdown()],{type:&#x27;text/markdown;charset=utf-8&#x27;});\n      objectUrl=URL.createObjectURL(blob);\n      a.href=objectUrl;\n    }else{\n      a.href=&#x27;data:text/markdown;charset=utf-8,&#x27;+encodeURIComponent(buildMarkdown());\n    }\n    document.body.appendChild(a);\n    a.click();\n    a.remove();\n    if(objectUrl&amp;&amp;window.URL&amp;&amp;typeof URL.revokeObjectURL===&#x27;function&#x27;){\n      setTimeout(function(){URL.revokeObjectURL(objectUrl);},500);\n    }\n    if(status){status.textContent=&#x27;Markdown 다운로드를 완료했습니다.&#x27;;}\n  }\n  root.addEventListener(&#x27;input&#x27;,function(e){\n    if(e.target&amp;&amp;e.target.matches(&#x27;[data-rev-field]&#x27;)){save(false);}\n  });\n  root.addEventListener(&#x27;change&#x27;,function(e){\n    if(e.target&amp;&amp;e.target.matches(&#x27;[data-rev-field]&#x27;)){save(false);}\n  });\n  root.addEventListener(&#x27;click&#x27;,function(e){\n    var b=e.target.closest(&#x27;[data-rev-action]&#x27;);\n    if(!b){return;}\n    var act=b.getAttribute(&#x27;data-rev-action&#x27;);\n    if(act===&#x27;save&#x27;){save(true);}\n    if(act===&#x27;download&#x27;){download();}\n    if(act===&#x27;reset&#x27;&amp;&amp;confirm(&#x27;이 클립에 저장된 입력을 초기화하시겠습니까?&#x27;)){\n      fields.forEach(function(f){f.value=&#x27;&#x27;;});\n      try{localStorage.removeItem(storageKey);}catch(ignore){}\n      if(status){status.textContent=&#x27;입력을 초기화했습니다.&#x27;;}\n    }\n  });\n  restore();\n})(this.closest(&#x27;section&#x27;));\">\n<div class=\"phase-banner\">❸ 마무리 <span class=\"phase-sub\">— 다음 챕터 연결</span></div>\n<div class=\"info-block key-message\" style=\"margin-top:18px\">\n<div class=\"info-block-title\">이번 클립의 핵심 메시지</div>\n<div>팀 진단과 30일 AI 협업 시범 운영안이 하나의 근거 문서로 통합됐습니다. <strong>CH03_우리팀_성장역량과_AI협업_통합본_성명.md</strong>는 CH04 NotebookLM 실습의 필수 2 소스입니다 — 저장 위치를 지금 확인하세요.</div>\n</div>\n<div class=\"clip-section\"><div class=\"clip-section-title\">다음 단계 연결</div><div class=\"clip-section-content\"><div class=\"tip-block next-step-card\"><div class=\"tip-block-title\">업로드 파일 확인 후 CH04로 이동합니다</div><div class=\"tip-block-content\">휴식 후 CH04에서 NotebookLM에 CH02·CH03 산출물을 업로드해 30일 실행계획을 만듭니다. 위 회수 체크표는 CH03 산출물 점검이고, NotebookLM에 업로드할 CH04 소스는 별도 3개입니다 — CH02 통합본·CH03 통합본(방금 저장)·R1~3 토론 정리본 통합본을 휴식 시간에 최종 확인하세요.</div></div></div></div>\n<div class=\"clip-nav-footer\"><a class=\"clip-nav-btn\" href=\"#ch03-clip01b\">← Round 3 · AI로 팀의 성과와 성장을 어떻게 함께 높일 것인가</a><a class=\"clip-nav-btn\" href=\"#ch03-clip02\">참고: Gemini 접속 방법 및 Gems 소개</a><a class=\"clip-nav-btn\" href=\"#ch04-clip01\">NotebookLM 소개 및 접속 방법 →</a></div>\n</section>\n",
  "text": "~15분CH 03통합 저장 Gate\nCH03 통합 저장 Gate: 성장역량·일하는 방식·팀 실험 통합\n\nCH03의 기존 3단계 실습 결과와 Round 3 AI 협업 시범 운영안을 하나의 CH04 입력자료로 통합합니다. 확인된 사실·리더 해석·구조적 병목 가설·팀원 확인 필요를 분리하고, 30일 지표·행동·Quality Gate가 같은 논리로 연결되는지 확인합니다. 항목을 직접 작성할 필요는 없습니다 — 앞선 「조직(팀) 성장역량과 일하는 방식 점검」 실습 대화를 이어 AI가 통합본을 만들어 주고, 출력 결과를 붙여넣어 저장만 하면 됩니다. 시범 운영안 파일이 없는 경우에는 Round 3에서 합의한 Workflow·행동·지표를 프롬프트 실행 시 대화에 직접 입력해 보완합니다.\n\n✅ 이 클립의 필수 산출물 — 놓치면 다음 실습이 막힙니다\n- CH03_우리팀_성장역량과_AI협업_통합본_성명.md — AI 출력 붙여넣기 → [통합 Markdown 다운로드]로 저장 (개인) → CH04 NotebookLM 필수 2 소스 — CH03의 최종 산출물\n\n- 📎 통합 전 회수 확인: 3-1 필수 2종 + R3 나의 토론 정리본(통합본) (아래 회수 체크표)\n- 💡 CH04_R1-3_팀토론정리본_성명.md는 Round 3 클립(3-1b)의 [내 논의 내용 제출] 박스 아래 또는 4-2의 「📦 통합본 다운로드」 상자에서 받을 수 있습니다.\n\n❶ 점검 — CH03 학습·산출물 연결 확인\n\nCH03 학습내용 한눈에 연결\n\nSTEP 1팀 현황·이슈실제 장면에서 표면 증상과 구조적 병목 가설, 근거 수준을 구분했습니다.\n\nSTEP 2팀 성장역량 지표30일 안에 확인할 정량·정성 선행지표와 측정 방법을 설계했습니다.\n\nSTEP 3조직·인재 행동역량리더·팀원·팀 공통의 관찰 가능한 행동 기준을 정의했습니다.\n\nROUND 330일 팀 시범 운영AI·리더·팀원 역할, 성장·피드백·Speak-up, Quality Gate(중단 기준)를 합의했습니다.\n\n필수 산출물 회수 체크\n산출물\t권장 파일명\t통합 확인\n\n팀 성장역량 구조적 병목·점검지표\tCH03_우리팀_성장역량_점검지표_성명.md\t사실·해석·가설·확인 필요가 구분되어 있는가\n\n우리 팀에 필요한 행동역량\tCH03_우리팀_필요행동역량_성명.md\t역량명이 아니라 실제 장면·행동·관찰 증거로 작성되었는가\n\nRound 3 AI 협업 시범 운영안\n(나의 토론 정리본)\tCH04_R1-3_팀토론정리본_성명.md (R3 포함 · 백업: CH03_R3_30일_AI협업_시범운영안_팀번호.md)\t한 개 Workflow, AI·리더·팀원 역할, 지표·중단 기준이 있는가\n\n❷ 통합 저장 — 프롬프트 실행 → 출력 붙여넣기 → 다운로드\n\n통합본 생성·저장\n\nGATE 1프롬프트 실행아래 프롬프트를 복사해 앞선 「조직(팀) 성장역량과 일하는 방식 점검」 실습 대화에 이어서 실행합니다. 점검지표·행동역량 근거는 이미 대화에 있으므로 Round 3 내용이 담긴 파일 1개만 첨부합니다 (권장: CH04_R1-3_팀토론정리본_성명.md · 백업: CH03_R3_30일_AI협업_시범운영안_팀번호.md).\n\nGATE 2출력 복사ChatGPT가 통합본을 Markdown 코드블록으로 만들어 줍니다. 근거 수준 점검 결과를 확인한 뒤 코드블록을 복사합니다.\n\nGATE 3붙여넣고 다운로드아래 칸에 붙여넣고 [통합 Markdown 다운로드]를 누르면 표준 파일명으로 저장됩니다. 직접 입력은 성명 1칸뿐입니다.\n\n이어서형같은 ChatGPT 대화CH03 통합본 생성·근거 수준 점검프롬프트 15줄복사\n\n📎 입력 필수 · 앞선 「조직(팀) 성장역량과 일하는 방식 점검」 실습 대화 이어가기 + CH04_R1-3_팀토론정리본_성명.md (백업: CH03_R3_30일_AI협업_시범운영안_팀번호.md) 첨부 (새 대화일 때만 3개 모두 첨부: CH03_우리팀_성장역량_점검지표_성명.md + CH03_우리팀_필요행동역량_성명.md + CH04_R1-3_팀토론정리본_성명.md)\n현재 대화에 이미 있는 CH03 팀 현황·점검지표·행동역량 근거와 새로 첨부한 파일 중 Round 3(AI 협업 시범 운영안) 부분만 사용하여(첨부 파일에 Round 1·2 정리본이 함께 있어도 Round 3 부분만 사용, 새 대화에서 시작한 경우에는 3개 파일을 모두 첨부한 뒤) 「우리 팀 성장역량·AI 협업 통합본」을 작성해 주세요. 전체를 Markdown 코드블록(```)으로 출력해 주세요.\n\n[필수 구성]\n1. 실제 업무 장면과 확인된 사실\n2. 리더의 해석\n3. 구조적 병목 가설\n4. 팀원·조직에 확인할 질문\n5. 30일 정량 지표와 정성 증거\n6. 리더·팀원·팀 공통 행동역량\n7. Round 3의 한 개 Workflow 실험과 AI·팀원·리더 역할\n8. 성장·피드백·Speak-up 장치\n9. 인간 승인·중단·Fallback\n10. CH04에서 비교할 실행 후보 3개 이하\n\n서베이 조직 전체 신호를 우리 팀 사실·Baseline으로 사용하지 말고, 자료에 없는 수치·원인을 만들지 마세요. 중요한 판단마다 어떤 입력자료가 근거인지 표시해 주세요.\n\n성명\nAI 통합본 붙여넣기붙여넣은 내용이 있으면 그 내용이 그대로 저장되고, 비어 있으면 아래 「직접 작성형」 항목으로 파일을 만듭니다. 입력 내용은 브라우저에 자동 저장됩니다.\n\n초기화브라우저 저장통합 Markdown 다운로드\n💾 저장 파일명 확인: CH03_우리팀_성장역량과_AI협업_통합본_성명.md\n\n입력 내용은 현재 브라우저에 자동 저장됩니다.\n\n직접 작성형 (선택) — 항목별로 직접 정리하고 싶은 경우아래 항목을 작성한 뒤 위 [통합 Markdown 다운로드] 버튼을 사용합니다. 이때 위 붙여넣기 칸은 비워 둡니다.\n\n반복되는 실제 업무 장면\n\n확인된 사실\n\n리더의 해석\n\n구조적 병목 가설\n\n팀원·조직 확인 필요\n\n30일 정량 지표\n\n30일 정성 증거\n\n리더·팀원·팀 행동역량\n\n30일 AI 협업 시범 운영\n\nAI·팀원·리더 역할\n\n성장·피드백·Speak-up 장치\n\n인간 승인·중단·Fallback\n\nCH04 실행 후보 3개 이하\n\nGate 통과 기준 근거 수준이 분리되어 있고, 지표와 행동이 실제 업무 장면에 연결되며, Round 3 실험이 한 개 Workflow로 좁혀져 있고, CH04 업로드용 통합 파일이 저장되었습니다.\n\n❸ 마무리 — 다음 챕터 연결\n\n이번 클립의 핵심 메시지\n\n팀 진단과 30일 AI 협업 시범 운영안이 하나의 근거 문서로 통합됐습니다. CH03_우리팀_성장역량과_AI협업_통합본_성명.md는 CH04 NotebookLM 실습의 필수 2 소스입니다 — 저장 위치를 지금 확인하세요.\n\n다음 단계 연결\n업로드 파일 확인 후 CH04로 이동합니다\n휴식 후 CH04에서 NotebookLM에 CH02·CH03 산출물을 업로드해 30일 실행계획을 만듭니다. 위 회수 체크표는 CH03 산출물 점검이고, NotebookLM에 업로드할 CH04 소스는 별도 3개입니다 — CH02 통합본·CH03 통합본(방금 저장)·R1~3 토론 정리본 통합본을 휴식 시간에 최종 확인하세요.",
