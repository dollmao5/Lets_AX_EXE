  "html": "<section class=\"ch01-clip02-integrated-v2\" id=\"ch01-clip02\">\r\n<style>\r\n    .ch01-clip02-integrated-v2 {\r\n      --c1i-brand: var(--brand, #a50034);\r\n      --c1i-text: var(--text-body, #334155);\r\n      --c1i-heading: var(--text-heading, #172033);\r\n      --c1i-secondary: var(--text-secondary, #667085);\r\n      --c1i-border: var(--border, #e4e7ec);\r\n      --c1i-offwhite: var(--bg-offwhite, #f8f9fb);\r\n      --c1i-white: var(--bg-white, #fff);\r\n      --c1i-soft: color-mix(in srgb, var(--c1i-brand) 7%, #fff);\r\n      --c1i-soft-strong: color-mix(in srgb, var(--c1i-brand) 12%, #fff);\r\n      --c1i-radius: 18px;\r\n      --c1i-gap: 16px;\r\n      font-size: 20px;\r\n      line-height: 1.72;\r\n      color: var(--c1i-text);\r\n      word-break: keep-all;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 *,\r\n    .ch01-clip02-integrated-v2 *::before,\r\n    .ch01-clip02-integrated-v2 *::after { box-sizing: border-box; }\r\n\r\n    .ch01-clip02-integrated-v2 .clip-title {\r\n      margin-top: 10px;\r\n      font-size: clamp(2rem, 3.2vw, 2.7rem) !important;\r\n      line-height: 1.22 !important;\r\n      letter-spacing: -0.04em;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .clip-badge {\r\n      padding: 8px 12px !important;\r\n      border-radius: 999px !important;\r\n      font-size: 0.95rem !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .clip-overview {\r\n      padding: 24px 26px !important;\r\n      border-radius: var(--c1i-radius) !important;\r\n      font-size: 1.16rem !important;\r\n      line-height: 1.78 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .clip-section-title {\r\n      margin-bottom: 14px !important;\r\n      font-size: 1.5rem !important;\r\n      line-height: 1.35 !important;\r\n      letter-spacing: -0.025em;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .clip-section-content,\r\n    .ch01-clip02-integrated-v2 p,\r\n    .ch01-clip02-integrated-v2 li,\r\n    .ch01-clip02-integrated-v2 .info-block