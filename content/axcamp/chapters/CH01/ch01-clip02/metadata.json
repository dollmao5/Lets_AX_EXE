splay: inline-flex;\r\n      align-items: center;\r\n      min-height: 28px;\r\n      margin-bottom: 10px;\r\n      padding: 4px 9px;\r\n      border-radius: 999px;\r\n      background: var(--c1i-soft);\r\n      color: var(--c1i-brand);\r\n      font-size: 0.88rem !important;\r\n      line-height: 1.2 !important;\r\n      font-weight: 900;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .axis-card strong {\r\n      display: block;\r\n      margin-bottom: 8px;\r\n      color: var(--c1i-heading);\r\n      font-size: 1.08rem !important;\r\n      line-height: 1.42 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .axis-card p {\r\n      margin: 0 !important;\r\n      color: var(--c1i-text);\r\n      font-size: 1rem !important;\r\n      line-height: 1.58 !important;\r\n    }\r\n\r\n    /* 통합 3단계 카드 */\r\n    .ch01-clip02-integrated-v2 .roadmap-grid {\r\n      display: grid;\r\n      grid-template-columns: repeat(3, minmax(0, 1fr));\r\n      gap: var(--c1i-gap);\r\n      margin: 12px 0 18px;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-card {\r\n      position: relative;\r\n      min-width: 0;\r\n      overflow: hidden;\r\n      border: 1px solid var(--c1i-border);\r\n      border-radius: var(--c1i-radius);\r\n      background: var(--c1i-white);\r\n      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-card::before {\r\n      content: \"\";\r\n      display: block;\r\n      height: 6px;\r\n      background: var(--c1i-brand);\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-card-body { padding: 20px; }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-level {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      min-height: 30px;\r\n      margin-bottom: 10px;\r\n      padding: 5px 10px;\r\n      border-radius: 999px;\r\n      background: var(--c1i-soft);\r\n      color: var(--c1i-brand);\r\n      font-size: 0.9rem !important;\r\n      line-height: 1.2 !important;\r\n      font-weight: 900;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-title {\r\n      margin: 0 0 6px;\r\n      color: var(--c1i-heading);\r\n      font-size: 1.24rem !important;\r\n      line-height: 1.38 !important;\r\n      font-weight: 950;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-tagline {\r\n      margin-bottom: 10px;\r\n      color: var(--c1i-brand);\r\n      font-size: 0.98rem !important;\r\n      line-height: 1.42 !important;\r\n      font-weight: 850;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-copy {\r\n      margin: 0 0 14px !important;\r\n      color: var(--c1i-text);\r\n      font-size: 1rem !important;\r\n      line-height: 1.6 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-loop {\r\n      margin: 0 0 14px;\r\n      padding: 11px 12px;\r\n      border: 1px dashed var(--c1i-border);\r\n      border-radius: 13px;\r\n      background: var(--c1i-offwhite);\r\n      color: var(--c1i-heading);\r\n      font-size: 0.94rem !important;\r\n      line-height: 1.5 !important;\r\n      font-weight: 850;\r\n      text-align: center;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-points {\r\n      margin: 0 0 14px;\r\n      padding-left: 22px;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-points li {\r\n      margin-bottom: 7px;\r\n      font-size: 0.98rem !important;\r\n      line-height: 1.55 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-branch-grid {\r\n      display: grid;\r\n      gap: 9px;\r\n      margin: 0 0 14px;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-branch {\r\n      padding: 11px 12px;\r\n      border: 1px solid var(--c1i-border);\r\n      border-radius: 13px;\r\n      background: var(--c1i-offwhite);\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-branch strong {\r\n      display: block;\r\n      margin-bottom: 4px;\r\n      color: var(--c1i-heading);\r\n      font-size: 0.92rem !important;\r\n      line-height: 1.4 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .stage-branch span {\r\n      display: block;\r\n      color: var(--c1i-text);\r\n      font-size: 0.9rem !important;\r\n      line-height: 1.48 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .tool-tags {\r\n      display: flex;\r\n      flex-wrap: wrap;\r\n      gap: 7px;\r\n      margin: 0 0 14px;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .tool-tag {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      min-height: 28px;\r\n      padding: 4px 9px;\r\n      border: 1px solid var(--c1i-border);\r\n      border-radius: 999px;\r\n      background: #fff;\r\n      color: var(--c1i-text);\r\n      font-size: 0.84rem !important;\r\n      line-height: 1.2 !important;\r\n      font-weight: 850;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .human-role {\r\n      padding-top: 12px;\r\n      border-top: 1px solid var(--c1i-border);\r\n      color: var(--c1i-secondary);\r\n      font-size: 0.94rem !important;\r\n      line-height: 1.52 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .human-role strong { color: var(--c1i-heading); }\r\n\r\n    /* 비교표 */\r\n    .ch01-clip02-integrated-v2 .table-wrap {\r\n      width: 100%;\r\n      margin: 12px 0 18px;\r\n      overflow-x: auto;\r\n      -webkit-overflow-scrolling: touch;\r\n      border: 1px solid var(--c1i-border);\r\n      border-radius: 16px;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .table-wrap table {\r\n      min-width: 1040px;\r\n      margin: 0 !important;\r\n      border: 0 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .comparison-table th,\r\n    .ch01-clip02-integrated-v2 .comparison-table td {\r\n      padding: 9px 12px !important;\r\n      vertical-align: middle !important;\r\n      font-size: 1.02rem !important;\r\n      line-height: 1.48 !important;\r\n      word-break: keep-all;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .comparison-table th {\r\n      color: var(--c1i-heading) !important;\r\n      background: var(--c1i-offwhite) !important;\r\n      font-weight: 900 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .comparison-table td:first-child {\r\n      width: 152px;\r\n      color: var(--c1i-heading);\r\n      font-weight: 900;\r\n      white-space: nowrap;\r\n    }\r\n\r\n    /* 리더 체크포인트 */\r\n    .ch01-clip02-integrated-v2 .leader-grid {\r\n      display: grid;\r\n      grid-template-columns: repeat(3, minmax(0, 1fr));\r\n      gap: var(--c1i-gap);\r\n      margin: 12px 0 18px;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .leader-card {\r\n      min-width: 0;\r\n      padding: 18px;\r\n      border: 1px solid var(--c1i-border);\r\n      border-radius: var(--c1i-radius);\r\n      background: linear-gradient(135deg, #fff, var(--c1i-offwhite));\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .leader-number {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      width: 36px;\r\n      height: 36px;\r\n      margin-bottom: 10px;\r\n      border-radius: 12px;\r\n      background: var(--c1i-brand);\r\n      color: #fff;\r\n      font-size: 0.92rem !important;\r\n      line-height: 1 !important;\r\n      font-weight: 950;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .leader-card strong {\r\n      display: block;\r\n      margin-bottom: 7px;\r\n      color: var(--c1i-heading);\r\n      font-size: 1.04rem !important;\r\n      line-height: 1.42 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .leader-card p {\r\n      margin: 0 !important;\r\n      color: var(--c1i-text);\r\n      font-size: 0.98rem !important;\r\n      line-height: 1.56 !important;\r\n    }\r\n\r\n    .ch01-clip02-integrated-v2 .visually-hidden {\r\n      position: absolute !important;\r\n      width: 1px !important;\r\n      height: 1px !important;\r\n      padding: 0 !important;\r\n      margin: -1px !important;\r\n      overflow: hidden !important;\r\n      clip: rect(0 0 0 0) !important;\r\n      white-space: nowrap !important;\r\n      border: 0 !important;\r\n    }\r\n\r\n    @media (max-width: 1040px) {\r\n      .ch01-clip02-integrated-v2 .roadmap-grid,\r\n      .ch01-clip02-integrated-v2 .leader-grid {\r\n        grid-template-columns: 1fr;\r\n      }\r\n    }\r\n\r\n    @media (max-width: 760px) {\r\n      .ch01-clip02-integrated-v2 { font-size: 18px; }\r\n      .ch01-clip02-integrated-v2 .clip-overview { padding: 20px !important; }\r\n      .ch01-clip02-integrated-v2 .axis-grid { grid-template-columns: 1fr; }\r\n      .ch01-clip02-integrated-v2 .stage-card-body { padding: 18px; }\r\n    }\r\n  </style>\r\n<div class=\"clip-header\">\r\n<div class=\"clip-badges\">\r\n<span class=\"clip-badge time\">~12분</span>\r\n<span class=\"clip-badge chapter\">CH 01</span>\r\n<span class=\"clip-badge type-concept\">개념</span>\r\n</div>\r\n<h1 class=\"clip-title\" data-keep-title=\"\">Assistant에서 Agentic AI로: 기술 활용 로드맵</h1>\r\n</div>\r\n<div class=\"clip-overview\">\r\n    조직의 AI 활용은 사람이 질문하고 결과를 다듬는 <strong>AI Assistant</strong>에서 시작해,\r\n    작은 AI 앱·자동화 도구를 만들거나 목표를 맡기는 <strong>확장 단계</strong>를 거쳐,\r\n    Agent·도구·데이터·규칙·사람의 승인 지점을 연결한 <strong>Agentic AI</strong>로 발전합니다.<br/>\r\n    이번 클립에서는 <strong>AI의 자율성</strong>과 <strong>기술 구현 방식</strong>을 하나의 로드맵으로 연결하고,\r\n    자율성이 커질수록 팀장이 무엇을 설계·검증·승인·책임해야 하는지 확인합니다.\r\n  </div>\r\n<!-- [ENRICHMENT 2026-07-25] 강사 도입 자료 블록(핵심 요약 포함). 복구: 이 주석부터 [ENRICHMENT END]까지 삭제 (scripts/remove-enrichment.mjs 사용 가능) -->\r\n<details class=\"intro-collapse\" style=\"margin:14px 0 18px;border:2px solid #4f46e5;border-left-width:8px;border-radius:16px;background:#eef2ff;\">\r\n<summary style=\"cursor:pointer;padding:13px 20px;font-weight:800;font-size:1rem;color:#312e81;\">🎬 생각 열기 — 실제 사례와 데이터</summary>\r\n<div style=\"padding:0 20px 14px;\">\r\n<div style=\"margin:10px 0 4px;font-weight:800;color:#312e81;\">📺 KBS 시사기획 창 (2026.3.17 방송) 세그먼트 — “이제 AI는 스스로 생각하고 학습한다” (전체 47:29 중 구간 발췌)</div>\r\n<div style=\"margin:4px 0 10px;font-size:.98rem;line-height:1.65;\">영상 요지: 질문에 답하는 AI를 넘어, <strong>목표를 주면 계획을 세우고 정보를 찾고 컴퓨터를 직접 조작해 실행까지 하는 'AI 에이전트'</strong>를 KBS 제작진이 직접 검증한 방송입니다. 🎯 영상을 보며 <mark style=\"background:#fef08a;color:#713f12;font-weight:800;padding:1px 6px;border-radius:6px;\">'사람이 한 일'이 무엇이었는지</mark>에 주목하세요 — <strong>Assistant와 Agent의 차이</strong>가 그 장면에 있습니다.</div>\r\n<div style=\"margin:10px 0 16px;padding:14px 18px;border:1.5px dashed #4f46e5;border-radius:12px;background:#fff;font-size:1.04rem;line-height:1.7;color:#312e81;font-weight:600;\">에이전트가 호텔을 예약하는 동안 사람이 한 일은 두 가지뿐입니다 — <mark style=\"background:#fef08a;color:#713f12;font-weight:800;padding:1px 6px;border-radius:6px;\">목표와 조건을 정해 준 것</mark>, 그리고 <mark style=\"background:#fef08a;color:#713f12;font-weight:800;padding:1px 6px;border-radius:6px;\">결과를 확인·승인한 것</mark>. AI의 자율성이 커질수록 리더의 일은 '직접 실행'에서 <mark style=\"background:#fef08a;color:#713f12;font-weight:800;padding:1px 6px;border-radius:6px;\">목표 설정 → 경계 설계 → 검증 → 승인 → 책임</mark>으로 이동합니다. <strong>오늘 CH02의 리더 역할·책임경계 실습과 CH03~04의 30일 실행계획이 바로 그 이동을 준비하는 시간입니다.</strong></div>\r\n<div style=\"margin:10px 0 4px;font-weight:700;\">▶ 구간 ① (필수 · 약 3분) — 스스로 생각하고 학습하는 AI</div>\r\n<div style=\"margin:2px 0 8px;font-size:.93rem;\">핵심내용: 질문에 답만 하던 챗봇을 넘어, <strong>스스로 생각·계획·학습하는 AI(에이전트)</strong>가 등장했다는 개념 설명과 KBS 제작진의 검증 실험 소개입니다.</div>\r\n<!-- [HIDDEN 2026-07-31] 유튜브 임베드(광고 노출)를 로컬 편집본으로 교체. 복구: 아래 video 태그를 지우고 이 주석 안의 iframe을 되살립니다.\r\n<iframe width=\"100%\" style=\"aspect-ratio:16/9;border:0;border-radius:12px;\" src=\"https://www.youtube.com/embed/oQ4_7ZX9oWs?start=316&amp;end=499&amp;rel=0\" title=\"KBS 시사기획 창 — AI 에이전트 (구간 1)\" loading=\"lazy\" allowfullscreen></iframe>\r\n-->\r\n<video controls preload=\"metadata\" width=\"100%\" style=\"aspect-ratio:16/9;border-radius:12px;background:#000;\"><source src=\"/course-files/AXCAMP/ch01-clip02/assets/ch01-clip02-kbs-agentic-seg1.mp4\" type=\"video/mp4\"/>브라우저가 동영상 재생을 지원하지 않습니다. 아래 전체 영상 링크를 이용하세요.</video>\r\n<div style=\"margin:12px 0 4px;font-weight:700;\">▶ 구간 ② (선택 · 약 4분, 시간 여유 시) — 여행 에이전트 시연</div>\r\n<div style=\"margin:2px 0 8px;font-size:.93rem;\">핵심내용: 일정·경비·목적만 정해 주면 에이전트가 <strong>화면을 직접 조작해 호텔을 검색·비교하고 예약까지 완료</strong>하는 시연 — '실행하는 AI'가 사람의 일을 어디까지 대신하는지 보여줍니다.</div>\r\n<!-- [HIDDEN 2026-07-31] 유튜브 임베드(광고 노출)를 로컬 편집본으로 교체. 복구: 아래 video 태그를 지우고 이 주석 안의 iframe을 되살립니다.\r\n<iframe width=\"100%\" style=\"aspect-ratio:16/9;border:0;border-radius:12px;\" src=\"https://www.youtube.com/embed/oQ4_7ZX9oWs?start=578&amp;end=825&amp;rel=0\" title=\"KBS 시사기획 창 — AI 에이전트 (구간 2)\" loading=\"lazy\" allowfullscreen></iframe>\r\n-->\r\n<video controls preload=\"metadata\" width=\"100%\" style=\"aspect-ratio:16/9;border-radius:12px;background:#000;\"><source src=\"/course-files/AXCAMP/ch01-clip02/assets/ch01-clip02-kbs-agentic-seg2.mp4\" type=\"video/mp4\"/>브라우저가 동영상 재생을 지원하지 않습니다. 아래 전체 영상 링크를 이용하세요.</video>\r\n<div style=\"margin-top:10px;font-size:.9rem;color:#3730a3;\">📺 전체 영상이 궁금하다면: <a href=\"https://www.youtube.com/watch?v=oQ4_7ZX9oWs\" target=\"_blank\" rel=\"noopener\"><strong>KBS 시사기획 창 전체 보기 (2026.3.17 방송 · 47:29, 유튜브)</strong></a> — 위 두 구간은 전체 방송 중 5:16~8:19, 9:38~13:45 발췌입니다.</div>\r\n\r\n</div>\r\n</details>\r\n<!-- [ENRICHMENT END] -->\r\n<div class=\"clip-section\">\r\n<div class=\"clip-section-title\">이번 클립에서 함께 배우는 것</div>\r\n<div class=\"clip-section-content\">\r\n<div class=\"axis-grid\">\r\n<article class=\"axis-card\">\r\n<span class=\"axis-kicker\">협업 자율성의 축</span>\r\n<strong style=\"display:block;margin:0 0 8px;color:var(--c1i-brand);font-size:1.38rem !important;line-height:1.35 !important;\">Assistant → Agent → Agentic AI</strong>\r\n<p>AI가 질문에 반응하는 수준에서, 목표를 받아 계획·도구 사용·결과 확인을 반복하고, 여러 실행 주체가 Workflow로 연결되는 수준까지 구분합니다.</p>\r\n</article>\r\n<article class=\"axis-card\">\r\n<span class=\"axis-kicker\">기술 구현의 축</span>\r\n<strong style=\"display:block;margin:0 0 8px;color:var(--c1i-brand);font-size:1.38rem !important;line-height:1.35 !important;\">대화형 사용 → AI 앱·자동화 → Agentic Workflow</strong>\r\n<p>사람과 AI의 대화에서 시작해 반복 가능한 작은 도구와 앱을 만들고, 여러 단계·시스템·승인 지점을 연결하는 방식으로 확장합니다.</p>\r\n</article>\r\n</div>\r\n\r\n</div>\r\n</div>\r\n<div class=\"clip-section slide-preview-shell\">\r\n<div class=\"slide-preview-head\">\r\n<p class=\"slide-briefing-eyebrow\">NotebookLM Slide Deck</p>\r\n<div class=\"slide-preview-top\">\r\n<div>\r\n<h2 class=\"slide-briefing-title\">묻고 다듬기에서 작은 도구 만들기, 여러 단계 맡기기로 확장되는 활용 로드맵</h2>\r\n<p class=\"slide-briefing-desc\">\r\n            NotebookLM Studio의 <strong>Enterprise AI Roadmap</strong> 슬라이드 3장을 활용합니다.\r\n            단계별 인터페이스와 대표 도구를 확인하되, 제품명보다 <strong>계획 범위·실행 권한·도구 연결·사람의 승인 지점</strong>에 주목합니다.\r\n          </p>\r\n</div>\r\n<div class=\"slide-preview-actions\">\r\n<a class=\"slide-briefing-link\" data-slide-deck-download=\"tech-utilization-roadmap\">다운로드</a>\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"slide-preview-gallery\" data-slide-deck-preview=\"tech-utilization-roadmap\"></div>\r\n</div>\r\n<div class=\"clip-section\">\r\n<div class=\"clip-section-title\">한눈에 보는 통합 3단계 로드맵</div>\r\n<div class=\"clip-section-content\">\r\n<div class=\"roadmap-grid\">\r\n<article class=\"stage-card\">\r\n<div class=\"stage-card-body\">\r\n<span class=\"stage-level\">Level 1 · 입문</span><h2 class=\"stage-title\" style=\"margin:0 0 8px;color:var(--c1i-brand);font-size:1.38rem !important;\">AI Assistant : 묻고, 확인하고, 함께 다듬기</h2>\r\n<p class=\"stage-copy\">\r\n              사람이 질문·자료·맥락을 제공하면 AI가 답변, 요약, 분석, 초안을 만들고 후속 대화를 통해 결과를 개선합니다.\r\n            </p>\r\n<div class=\"stage-loop\">질문·자료 → 답변 → 후속 대화</div>\r\n<ul class=\"stage-points\">\r\n<li>아이디어 탐색, 보고서·메일·회의록 초안</li>\r\n<li>소스 기반 리서치와 근거 확인</li>\r\n<li>사람의 지시와 검토가 자주 필요한 업무에 적합</li>\r\n</ul>\r\n<div aria-label=\"Level 1 대표 도구\" class=\"tool-tags\">\r\n<span class=\"tool-tag\">ChatGPT</span>\r\n<span class=\"tool-tag\">NotebookLM</span>\r\n\r\n</div>\r\n<div class=\"human-role\"><strong>팀장이 확인할 것:</strong> 충분한 맥락을 주었는가? 사실·누락·품질을 직접 검토했는가?</div>\r\n</div>\r\n</article>\r\n<article class=\"stage-card\">\r\n<div class=\"stage-card-body\">\r\n<span class=\"stage-level\">Level 2 · 확장</span><h2 class=\"stage-title\" style=\"margin:0 0 8px;color:var(--c1i-brand);font-size:1.38rem !important;\">AI 앱·자동화 / 범위형 Agent : 작은 도구를 만들거나 목표 맡기기</h2>\r\n<p class=\"stage-copy\">\r\n              반복 업무를 재사용 가능한 앱·도구로 만들거나, 명확한 목표와 허용 범위 안에서 AI가 여러 단계를 계획하고 수행하도록 확장합니다.\r\n            </p>\r\n<div aria-label=\"Level 2 두 가지 확장 경로\" class=\"stage-branch-grid\">\r\n<div class=\"stage-branch\">\r\n<strong>구현 확장 · AI 앱·자동화</strong>\r\n<span>사람이 정한 업무 흐름, 화면, 데이터 연결을 반복 가능한 서비스로 만듭니다.</span>\r\n</div>\r\n<div class=\"stage-branch\">\r\n<strong>자율성 확장 · AI Agent</strong>\r\n<span>목표 → 계획 → 도구 실행 → 결과 확인·수정을 허용 범위 안에서 반복합니다.</span>\r\n</div>\r\n</div>\r\n<ul class=\"stage-points\">\r\n<li>반복 지침과 출력 형식을 맞춤형 비서로 저장</li>\r\n<li>업무용 미니앱과 자동화 흐름을 설계</li>\r\n<li>권한·데이터·완료 기준·승인 지점을 명시</li>\r\n</ul>\r\n<div aria-label=\"Level 2 확장 사례\" class=\"tool-tags\">\r\n<span class=\"tool-tag\">ChatGPT Deep Research</span>\r\n<span class=\"tool-tag\">GPTs</span>\r\n<span class=\"tool-tag\">GPT Builder</span>\r\n<span class=\"tool-tag\">OpenAI API</span>\r\n</div>\r\n<div class=\"human-role\"><strong>팀장이 확인할 것:</strong> 목표와 완료 기준은 무엇인가? 권한과 데이터 범위는 어디까지이며 언제 사람이 승인하는가?</div>\r\n</div>\r\n</article>\r\n<article class=\"stage-card\">\r\n<div class=\"stage-card-body\">\r\n<span class=\"stage-level\">Level 3 · 자율</span><h2 class=\"stage-title\" style=\"margin:0 0 8px;color:var(--c1i-brand);font-size:1.38rem !important;\">Agentic AI : 여러 단계와 도구를 운영 구조로 연결하기</h2>\r\n<p class=\"stage-copy\">\r\n              하나 또는 여러 Agent가 도구·데이터·규칙과 연결되어 복수 단계 업무를 수행하고, 실행 결과를 바탕으로 다음 행동을 조정합니다.\r\n              중요한 판단에는 사람의 점검과 예외 처리 절차를 함께 설계합니다.\r\n            </p>\r\n<div class=\"stage-loop\">목표·이벤트 → 계획 → 도구 실행 → 확인·재계획</div>\r\n<ul class=\"stage-points\">\r\n<li>문제를 작은 Task로 나누고 순서를 조정</li>\r\n<li>코드·셸·브라우저·테스트·외부 시스템을 연결</li>\r\n<li>복잡한 문제 해결과 반복 검증이 많은 업무에 적합</li>\r\n</ul>\r\n<div aria-label=\"Level 3 확장 사례\" class=\"tool-tags\">\r\n<span class=\"tool-tag\">Codex</span>\r\n<span class=\"tool-tag\">Cline</span>\r\n<span class=\"tool-tag\">Hi-D Code</span>\r\n</div>\r\n<div class=\"human-role\"><strong>팀장이 확인할 것:</strong> 품질·보안·모니터링·예외 처리·Fallback·중단 기준·최종 책임자가 명확한가?</div>\r\n</div>\r\n</article>\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"clip-section\">\r\n<div class=\"clip-section-title\">자율성이 커질수록 팀장이 먼저 정할 것</div>\r\n<div class=\"clip-section-content\">\r\n<div class=\"leader-grid\">\r\n<article class=\"leader-card\">\r\n<div class=\"web-guide-card-head\" style=\"margin-bottom:8px;align-items:center;\"><span class=\"leader-number\" style=\"margin-bottom:0;\">1</span><strong style=\"margin:0;color:var(--c1i-heading);font-size:1.38rem !important;line-height:1.35 !important;\">어떤 수준이 이 업무에 적합한가?</strong></div>\r\n<p>업무의 반복성, 복잡성, 오류 영향, 데이터 민감도, 검증 비용을 보고 Assistant·앱·Agentic Workflow 중 적정 수준을 선택합니다.</p>\r\n</article>\r\n<article class=\"leader-card\">\r\n<div class=\"web-guide-card-head\" style=\"margin-bottom:8px;align-items:center;\"><span class=\"leader-number\" style=\"margin-bottom:0;\">2</span><strong style=\"margin:0;color:var(--c1i-heading);font-size:1.38rem !important;line-height:1.35 !important;\">AI가 어디까지 계획·결정·실행하는가?</strong></div>\r\n<p>목표, 권한, 데이터 범위, 완료 기준, 사람의 승인 지점, AI에게 맡기지 않을 판단을 명시합니다.</p>\r\n</article>\r\n<article class=\"leader-card\">\r\n<div class=\"web-guide-card-head\" style=\"margin-bottom:8px;align-items:center;\"><span class=\"leader-number\" style=\"margin-bottom:0;\">3</span><strong style=\"margin:0;color:var(--c1i-heading);font-size:1.38rem !important;line-height:1.35 !important;\">오류와 예외가 생기면 어떻게 멈추는가?</strong></div>\r\n<p>근거 확인, 로그와 모니터링, 예외 처리, Fallback, 중단 조건과 최종 책임자를 사전에 정합니다.</p>\r\n</article>\r\n</div>\r\n\r\n</div>\r\n</div>\r\n\r\n\r\n\r\n<div class=\"info-block key-message\" style=\"margin-top:18px\">\r\n<div class=\"info-block-title\">이번 클립의 핵심 메시지</div>\r\n<div><strong>AI 활용의 핵심은 AI에게 많이 맡기는 것이 아니라, 무엇을 위임하고 어디에서 사람이 확인하며 누가 최종 책임질지를 설계하는 것입니다.</strong> 높은 단계가 항상 더 좋은 것도 아닙니다. 최적의 수준은 자율성의 크기가 아니라 업무 성과와 리스크를 가장 잘 통제하는 구조로 결정합니다.</div>\r\n</div>\r\n<div class=\"clip-nav-footer\"><a class=\"clip-nav-btn\" href=\"#ch01-clip01\">← AI 트렌드</a><a class=\"clip-nav-btn\" href=\"#ch01-clip03\">개념 다지기 →</a></div></section>\r\n",
  "text": "~12분\nCH 01\n개념\n\nAssistant에서 Agentic AI로: 기술 활용 로드맵\n\n조직의 AI 활용은 사람이 질문하고 결과를 다듬는 AI Assistant에서 시작해,\n작은 AI 앱·자동화 도구를 만들거나 목표를 맡기는 확장 단계를 거쳐,\nAgent·도구·데이터·규칙·사람의 승인 지점을 연결한 Agentic AI로 발전합니다.\n\n이번 클립에서는 AI의 자율성과 기술 구현 방식을 하나의 로드맵으로 연결하고,\n자율성이 커질수록 팀장이 무엇을 설계·검증·승인·책임해야 하는지 확인합니다.\n\n🎬 생각 열기 — 실제 사례와 데이터\n\n📺 KBS 시사기획 창 (2026.3.17 방송) 세그먼트 — “이제 AI는 스스로 생각하고 학습한다” (전체 47:29 중 구간 발췌)\n\n영상 요지: 질문에 답하는 AI를 넘어, 목표를 주면 계획을 세우고 정보를 찾고 컴퓨터를 직접 조작해 실행까지 하는 'AI 에이전트'를 KBS 제작진이 직접 검증한 방송입니다. 🎯 영상을 보며 '사람이 한 일'이 무엇이었는지에 주목하세요 — Assistant와 Agent의 차이가 그 장면에 있습니다.\n\n에이전트가 호텔을 예약하는 동안 사람이 한 일은 두 가지뿐입니다 — 목표와 조건을 정해 준 것, 그리고 결과를 확인·승인한 것. AI의 자율성이 커질수록 리더의 일은 '직접 실행'에서 목표 설정 → 경계 설계 → 검증 → 승인 → 책임으로 이동합니다. 오늘 CH02의 리더 역할·책임경계 실습과 CH03~04의 30일 실행계획이 바로 그 이동을 준비하는 시간입니다.\n\n▶ 구간 ① (필수 · 약 3분) — 스스로 생각하고 학습하는 AI\n\n핵심내용: 질문에 답만 하던 챗봇을 넘어, 스스로 생각·계획·학습하는 AI(에이전트)가 등장했다는 개념 설명과 KBS 제작진의 검증 실험 소개입니다.\n\n브라우저가 동영상 재생을 지원하지 않습니다. 아래 전체 영상 링크를 이용하세요.\n▶ 구간 ② (선택 · 약 4분, 시간 여유 시) — 여행 에이전트 시연\n\n핵심내용: 일정·경비·목적만 정해 주면 에이전트가 화면을 직접 조작해 호텔을 검색·비교하고 예약까지 완료하는 시연 — '실행하는 AI'가 사람의 일을 어디까지 대신하는지 보여줍니다.\n\n브라우저가 동영상 재생을 지원하지 않습니다. 아래 전체 영상 링크를 이용하세요.\n📺 전체 영상이 궁금하다면: KBS 시사기획 창 전체 보기 (2026.3.17 방송 · 47:29, 유튜브) — 위 두 구간은 전체 방송 중 5:16~8:19, 9:38~13:45 발췌입니다.\n\n이번 클립에서 함께 배우는 것\n\n협업 자율성의 축\nAssistant → Agent → Agentic AI\nAI가 질문에 반응하는 수준에서, 목표를 받아 계획·도구 사용·결과 확인을 반복하고, 여러 실행 주체가 Workflow로 연결되는 수준까지 구분합니다.\n\n기술 구현의 축\n대화형 사용 → AI 앱·자동화 → Agentic Workflow\n사람과 AI의 대화에서 시작해 반복 가능한 작은 도구와 앱을 만들고, 여러 단계·시스템·승인 지점을 연결하는 방식으로 확장합니다.\n\nNotebookLM Slide Deck\n\n묻고 다듬기에서 작은 도구 만들기, 여러 단계 맡기기로 확장되는 활용 로드맵\n\nNotebookLM Studio의 Enterprise AI Roadmap 슬라이드 3장을 활용합니다.\n단계별 인터페이스와 대표 도구를 확인하되, 제품명보다 계획 범위·실행 권한·도구 연결·사람의 승인 지점에 주목합니다.\n\n다운로드\n\n한눈에 보는 통합 3단계 로드맵\n\nLevel 1 · 입문AI Assistant : 묻고, 확인하고, 함께 다듬기\n\n사람이 질문·자료·맥락을 제공하면 AI가 답변, 요약, 분석, 초안을 만들고 후속 대화를 통해 결과를 개선합니다.\n\n질문·자료 → 답변 → 후속 대화\n\n- 아이디어 탐색, 보고서·메일·회의록 초안\n\n- 소스 기반 리서치와 근거 확인\n\n- 사람의 지시와 검토가 자주 필요한 업무에 적합\n\nChatGPT\nNotebookLM\n\n팀장이 확인할 것: 충분한 맥락을 주었는가? 사실·누락·품질을 직접 검토했는가?\n\nLevel 2 · 확장AI 앱·자동화 / 범위형 Agent : 작은 도구를 만들거나 목표 맡기기\n\n반복 업무를 재사용 가능한 앱·도구로 만들거나, 명확한 목표와 허용 범위 안에서 AI가 여러 단계를 계획하고 수행하도록 확장합니다.\n\n구현 확장 · AI 앱·자동화\n사람이 정한 업무 흐름, 화면, 데이터 연결을 반복 가능한 서비스로 만듭니다.\n\n자율성 확장 · AI Agent\n목표 → 계획 → 도구 실행 → 결과 확인·수정을 허용 범위 안에서 반복합니다.\n\n- 반복 지침과 출력 형식을 맞춤형 비서로 저장\n\n- 업무용 미니앱과 자동화 흐름을 설계\n\n- 권한·데이터·완료 기준·승인 지점을 명시\n\nChatGPT Deep Research\nGPTs\nGPT Builder\nOpenAI API\n\n팀장이 확인할 것: 목표와 완료 기준은 무엇인가? 권한과 데이터 범위는 어디까지이며 언제 사람이 승인하는가?\n\nLevel 3 · 자율Agentic AI : 여러 단계와 도구를 운영 구조로 연결하기\n\n하나 또는 여러 Agent가 도구·데이터·규칙과 연결되어 복수 단계 업무를 수행하고, 실행 결과를 바탕으로 다음 행동을 조정합니다.\n중요한 판단에는 사람의 점검과 예외 처리 절차를 함께 설계합니다.\n\n목표·이벤트 → 계획 → 도구 실행 → 확인·재계획\n\n- 문제를 작은 Task로 나누고 순서를 조정\n\n- 코드·셸·브라우저·테스트·외부 시스템을 연결\n\n- 복잡한 문제 해결과 반복 검증이 많은 업무에 적합\n\nCodex\nCline\nHi-D Code\n\n팀장이 확인할 것: 품질·보안·모니터링·예외 처리·Fallback·중단 기준·최종 책임자가 명확한가?\n\n자율성이 커질수록 팀장이 먼저 정할 것\n\n1어떤 수준이 이 업무에 적합한가?\n\n업무의 반복성, 복잡성, 오류 영향, 데이터 민감도, 검증 비용을 보고 Assistant·앱·Agentic Workflow 중 적정 수준을 선택합니다.\n\n2AI가 어디까지 계획·결정·실행하는가?\n\n목표, 권한, 데이터 범위, 완료 기준, 사람의 승인 지점, AI에게 맡기지 않을 판단을 명시합니다.\n\n3오류와 예외가 생기면 어떻게 멈추는가?\n\n근거 확인, 로그와 모니터링, 예외 처리, Fallback, 중단 조건과 최종 책임자를 사전에 정합니다.\n\n이번 클립의 핵심 메시지\n\nAI 활용의 핵심은 AI에게 많이 맡기는 것이 아니라, 무엇을 위임하고 어디에서 사람이 확인하며 누가 최종 책임질지를 설계하는 것입니다. 높은 단계가 항상 더 좋은 것도 아닙니다. 최적의 수준은 자율성의 크기가 아니라 업무 성과와 리스크를 가장 잘 통제하는 구조로 결정합니다.",
